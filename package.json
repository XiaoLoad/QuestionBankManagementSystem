{
  "name": "question-bank-manager",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n 后端,前端 -c blue,magenta \"node backend/server.js\" \"cd frontend && npm run dev\"",
    "db:init": "node backend/db-init.js",
    "prestart": "node backend/db-init.js",
    "start": "node backend/server.js",
    "build:web": "cd frontend && yarn build",
    "build": "yarn build:web && node backend/server.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "git-cliff": "^2.14.2"
  }
}
